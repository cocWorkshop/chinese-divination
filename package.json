{
  "name": "chinese-divination",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && next dev -H 0.0.0.0 -p 8088",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:unit": "vitest run --exclude src/__tests__/integration/**",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run --coverage",
    "predeploy-check": "npm run type-check && npm run lint && npm run test:ci",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "echo WARNING: db push drifts migration history - local throwaway DBs ONLY (see docs/prisma-migrations-recovery.md) && prisma db push",
    "db:backup": "node db_backup/backup.mjs",
    "db:restore": "node db_backup/restore.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@auth/prisma-adapter": "^2.0.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@prisma/client": "^6.0.0",
    "@sentry/nextjs": "^10.57.0",
    "@stripe/stripe-js": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "capacitor-native-biometric": "^4.2.2",
    "framer-motion": "^11.0.0",
    "iztro": "^2.5.8",
    "jsonrepair": "^3.14.0",
    "lunar-typescript": "^1.8.6",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^6.27.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "resend": "^6.9.4",
    "stripe": "^20.4.1",
    "taobi": "^0.4.5",
    "tyme4ts": "^1.4.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8",
    "prisma": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
}
