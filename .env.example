# ============================================
# Environment Variables Template
# Copy to .env.local (dev) or .env.production (deploy)
#
# Validated at server startup by src/lib/env.ts:
#   production → missing/invalid REQUIRED vars abort startup (fail-fast)
#   dev        → warning only
#   build/test → skipped (SKIP_ENV_VALIDATION=1 / NODE_ENV=test)
# ============================================

# ──────────────── REQUIRED ────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/divination_db"

# Auth
# IMPORTANT: in production set this to your canonical site URL (e.g.
# https://chinese-divination.com). All verification / password-reset / claim
# email links are built from it — request headers are NOT trusted (host-header
# injection guard in src/lib/email.ts).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# LLM (OpenRouter)
OPENROUTER_API_KEY="sk-or-..."

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_live_or_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend)
RESEND_API_KEY="re_..."

# ──────────────── OPTIONAL ────────────────

# Email sender address (default in code if unset)
EMAIL_FROM="noreply@chinese-divination.com"
# Extra origins allowed in email links besides NEXTAUTH_URL, comma-separated
# (e.g. "https://www.chinese-divination.com"). Usually unset.
# ALLOWED_EMAIL_ORIGINS=""

# LLM model overrides. Resolution order: AdminSetting → env → hardcoded default.
# OPENROUTER_MODEL=""          # divination/chat default model
# MASTER_MODEL=""              # Xuanji Master answer model
# PORTRAIT_MODEL=""            # background portrait-extraction model (cheaper)

# Extended-thinking strength per endpoint.
# Accepted values: low | medium | high | off
# Resolution order, per endpoint:
#   AdminSetting.<fn>ReasoningEffort → AdminSetting.llmReasoningEffort
#   → this per-fn env var → LLM_REASONING_EFFORT env → hardcoded default
# Defaults: divination=medium, chat=low, master=low, masterBackground=off
# DIVINATION_REASONING_EFFORT="medium"
# CHAT_REASONING_EFFORT="low"
# MASTER_REASONING_EFFORT="low"
# MASTER_BACKGROUND_REASONING_EFFORT="off"
# LLM_REASONING_EFFORT="medium"   # global fallback (applies to all endpoints if set)

# Divination requests ask the provider for JSON-constrained output
# (response_format: json_object, forwarded by OpenRouter; auto-retries once
# without it on providers that reject the param). Set to "off" to disable.
# DIVINATION_JSON_MODE="off"

# Xuanji Master: hours of inactivity before a chat session is considered
# stale and a new one starts (numeric; default in code if unset).
# MASTER_SESSION_STALE_HOURS="2"

# Local Claude CLI proxy for blocking completions (dev experiment; optional)
CLAUDE_PROXY_URL=""

# Google Analytics (public, baked in at build time)
# NEXT_PUBLIC_GA_ID="G-..."

# Sentry error tracking (optional — fully disabled while unset).
# Server-side errors:
# SENTRY_DSN="https://...@....ingest.sentry.io/..."
# Browser errors (baked in at build time; usually the same DSN):
# NEXT_PUBLIC_SENTRY_DSN="https://...@....ingest.sentry.io/..."
# Structured-log verbosity for src/lib/logger.ts (default: info)
# LOG_LEVEL="info"

# Log retention job (daily, in-process): scrubs PII from LlmLog rows >90d,
# deletes AuthLog rows >365d. Set to "1" to observe counts without writing.
# LOG_PURGE_DRY_RUN="1"

# ──────────────── DEPLOY ONLY ────────────────
PORT=3000
