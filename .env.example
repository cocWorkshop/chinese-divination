# ============================================
# Environment Variables Template
# Copy to .env.local (dev) or .env.production (deploy)
# ============================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/divination_db"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# LLM (OpenRouter)
OPENROUTER_API_KEY="sk-or-..."
# Optional: extended-thinking strength per endpoint.
# Accepted values: low | medium | high | off
# Per-function reasoning effort. Resolution order, per endpoint:
#   AdminSetting.<fn>ReasoningEffort → AdminSetting.llmReasoningEffort
#   → this per-fn env var → LLM_REASONING_EFFORT env → hardcoded default
# Defaults: divination=medium, chat=low, master=low, masterBackground=off
# DIVINATION_REASONING_EFFORT="medium"
# CHAT_REASONING_EFFORT="low"
# MASTER_REASONING_EFFORT="low"
# MASTER_BACKGROUND_REASONING_EFFORT="off"
# LLM_REASONING_EFFORT="medium"   # global fallback (applies to all endpoints if set)

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@chinese-divination.com"

# AI Chat (optional)
CLAUDE_PROXY_URL=""

# Deploy only
PORT=3000
