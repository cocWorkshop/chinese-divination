{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Fullstack: Next.js",
      "configurations": ["Next.js: Server", "Next.js: Client"],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Next.js: Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/next",
      "runtimeArgs": ["dev", "-H", "0.0.0.0", "-p", "8088"],
      "env": {
        "NODE_OPTIONS": "--inspect"
      },
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Next.js: Client",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8088",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    }
  ]
}
