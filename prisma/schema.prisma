generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  // Nullable for tentative users created mid-funnel — they have an email
  // but haven't set a password yet. Funnel completion (/start/unlock) sets
  // this and flips `tentative=false`. All compare(password, user.password)
  // call sites must null-guard before bcrypt.compare.
  password     String?
  name         String?
  language     String      @default("zh")
  birthDate    String?
  birthTime    String?
  birthPlace   String?
  gender       String?
  timeMode     String?     // "fuzzy" | "precise"
  exactTime    String?     // "HH:MM" for precise mode
  calendarType String?     // "solar" | "lunar"
  birthEnvironment String? // geographic birth environment (rural, urban, mountainous, etc.)
  birthLat         Float?
  birthLng         Float?
  isAdmin      Boolean     @default(false)
  isPaid       Boolean     @default(false)
  role         String      @default("user") // user | admin
  credits            Int       @default(3)  // unified credit points
  divinationCredits  Int       @default(3)  // deprecated — kept for migration
  chatCredits        Int       @default(3)  // deprecated — kept for migration
  usageDivination    Int       @default(0)  // audit: total divination count
  usageChat          Int       @default(0)  // audit: total chat Q&A rounds
  usageMaster        Int       @default(0)  // audit: total master conversation turns
  lastDailyBonus     DateTime?
  emailVerified     Boolean   @default(false)
  verificationToken String?   @unique
  tokenExpiry       DateTime?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  deleteToken       String?   @unique
  deleteTokenExpiry DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?   // active, canceled, past_due
  chatSummary  String?     @db.Text
  hourlyQuota  Int         @default(10)
  bonusModel1  Int         @default(0)
  bonusModel2  Int         @default(0)
  bonusChat    Int         @default(0)
  consentAt    DateTime?
  consentVersion String?   // version of privacy/terms the user agreed to
  // Master memory (Phase 1+):
  // - portraitEnabled: gates portrait extraction + personalized prompt block
  // - masterMemoryDisclosureSeenAt: tracks first-use disclosure modal
  portraitEnabled              Boolean   @default(true)
  masterMemoryDisclosureSeenAt DateTime?
  // Funnel / tentative-user fields (ad landing flow):
  // - tentative=true means the row was created by /api/start/init from an
  //   email entered mid-funnel; password is null until /start/unlock completes.
  // - signupCompletedAt is set when the funnel finishes (real registration).
  // - trialCreditsGranted prevents the same email from claiming the small
  //   trial Karma allotment more than once across funnel attempts.
  // - funnelSource stores utm_* + entry timestamp for attribution.
  tentative           Boolean   @default(false)
  signupCompletedAt   DateTime?
  trialCreditsGranted Boolean   @default(false)
  funnelSource        Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  readings      Reading[]
  rateLimits    RateLimit[]
  shareLinks    ShareLink[]
  familyMembers FamilyMember[]
  masterSession MasterSession?
  deviceTokens  DeviceToken[]
  notificationReads NotificationRead[]
  // Master memory relations
  masterMessages          MasterChatMessage[]
  portrait                UserPortrait?
  portraitHistory         UserPortraitHistory[]
  adminAccessLogsAsAdmin  AdminAccessLog[] @relation("AdminAccessLog_admin")
  adminAccessLogsAsTarget AdminAccessLog[] @relation("AdminAccessLog_target")
}

model Reading {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  modelTier      String        @default("model1")
  question       String?
  inputData      Json
  result         String        @db.Text
  language       String        @default("zh")
  targetType     String        @default("self")
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  status          String        @default("completed") // pending | completed | failed
  calculationData String?     @db.Text  // Raw programmatic calculation output (JSON) — BaZi/Ziwei/Qimen/Meihua
  llmPrompt       String?     @db.Text  // Full LLM prompt (system + user message)
  llmRawOutput    String?     @db.Text  // Raw LLM response before merge
  chatMessages    String?     @db.Text  // JSON array of {role, content, timestamp} chat messages
  rating         Int?          // 1-5 star rating (denormalized from ReadingFeedback)
  shareToken     String?       @unique
  creditsHeld    Int           @default(0) // credits deducted at /init (the "hold"); refunded by markFailed/cleanupStale on failure
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  feedbacks       ReadingFeedback[]

  @@index([userId])
  @@index([createdAt])
  @@index([userId, deletedAt])
  @@index([type])
}

model ReadingFeedback {
  id        String   @id @default(cuid())
  readingId String
  reading   Reading  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int?     // 1-5
  feedback  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([readingId, userId])
  @@index([readingId])
  @@index([userId])
}

model FamilyMember {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relation         String
  relationDetail   String?   // Required (enforced in app layer) when relation === 'other'
  name             String?
  birthDate        String?
  birthTime        String?
  birthPlace       String?
  gender           String?
  calendarType     String?   // "solar" or "lunar"
  timeMode         String?   // "fuzzy" or "exact"
  exactTime        String?   // "HH:MM" for precise mode
  birthLat         Float?
  birthLng         Float?
  birthEnvironment String? // geographic birth environment (rural, urban, mountainous, etc.)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  readings         Reading[]

  @@index([userId])
}

model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStart DateTime
  count       Int      @default(0)
  modelTier   String   @default("model1")
  updatedAt   DateTime @updatedAt

  @@unique([userId, windowStart, modelTier])
  @@index([userId, windowStart])
}

model ShareLink {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String    @unique
  used      Boolean   @default(false)
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LlmLog {
  id            String   @id @default(cuid())
  userId        String?
  endpoint      String   // "divination" | "chat" | "chat-summary"
  model         String   // actual model name used
  modelTier     String?  // "model1" | "model2"
  promptTokens  Int      @default(0)
  completionTokens Int   @default(0)
  totalTokens   Int      @default(0)
  latencyMs     Int      @default(0)
  status        String   @default("success") // "success" | "error"
  errorMessage  String?
  inputPreview  String?  @db.Text // user message (full)
  outputPreview String?  @db.Text // LLM response (full)
  systemPrompt  String?  @db.Text // system prompt (full)
  requestId     String?  // correlates with the JSON request logs (pino)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([endpoint])
}

model AdminSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SiteFeedback {
  id        String   @id @default(cuid())
  userId    String
  rating    Int?     // 1-5
  feedback  String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Compensation {
  id          String   @id @default(cuid())
  userId      String?
  email       String   // target email (may not have account yet)
  reason      String   @db.Text
  sourceType  String   @default("manual") // "error_log" | "llm_error" | "manual"
  sourceIds   String?  @db.Text // comma-separated error/log IDs
  bonusModel1 Int      @default(0)
  bonusModel2 Int      @default(0)
  bonusChat   Int      @default(0)
  token       String   @unique
  status      String   @default("pending") // "pending" | "sent" | "claimed" | "expired"
  createdAt   DateTime @default(now())
  sentAt      DateTime?
  claimedAt   DateTime?
  expiresAt   DateTime?

  @@index([email])
  @@index([status])
  @@index([token])
}

model AuthLog {
  id        String   @id @default(cuid())
  action    String   // "login" | "logout" | "register"
  status    String   // "success" | "failure"
  email     String
  userId    String?
  reason    String?  // failure reason: "invalid_password", "user_not_found", "email_not_verified", "email_exists", etc.
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
  @@index([action])
  @@index([status])
}

model FrontendError {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   // API endpoint that failed
  status    Int?     // HTTP status code
  error     String   @db.Text // error message
  context   String?  @db.Text // extra context (page, action, etc.)
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  titleEn   String
  content   String   @db.Text
  contentEn String   @db.Text
  type      String   @default("info")
  target    String   @default("all")
  active    Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reads     NotificationRead[]

  @@index([active])
  @@index([createdAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([userId, notificationId])
  @@index([userId])
  @@index([notificationId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @db.Text
  platform  String   // "ios" | "android"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@index([token])
}

model CreditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // "deduct" | "grant_daily" | "grant_purchase" | "grant_share" | "grant_compensation" | "grant_admin"
  amount    Int      // positive for grants, negative for deductions
  balance   Int      // credits balance AFTER this change
  source    String   // "divination:bazi" | "chat" | "master" | "stripe:sess_xxx" | "share:code_xxx" | "compensation:id_xxx" | "daily_bonus" | "admin"
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model WikiArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?  // short description for listing
  content     String   // markdown
  category    String   @default("general") // bazi, ziwei, iching, qimen, fengshui, meihua, liuyao, general
  coverImage  String?  // URL
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@index([sortOrder])
}

model GiftLink {
  id          String   @id @default(cuid())
  code        String   @unique // short URL code
  credits     Int      // credits to grant
  maxClaims   Int      @default(1) // how many users can claim (0 = unlimited)
  claimCount  Int      @default(0)
  note        String?  // admin note / description
  expiresAt   DateTime?
  createdBy   String   // admin userId
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  claims      GiftClaim[]

  @@index([code])
  @@index([createdAt])
}

model GiftClaim {
  id         String   @id @default(cuid())
  giftLinkId String
  userId     String
  credits    Int
  createdAt  DateTime @default(now())

  giftLink   GiftLink @relation(fields: [giftLinkId], references: [id])

  @@unique([giftLinkId, userId]) // each user can only claim once per link
  @@index([userId])
}

model WelcomeRule {
  id            String   @id @default(cuid())
  name          String
  condition     Json     // { stage: "new"|"beginner"|"intermediate"|"advanced"|"expert", isWeekend?: boolean }
  messages      Json     // { zh: ["msg1","msg2",...], en: ["msg1","msg2",...] }
  recommendType String?  // bazi, liuyao, ziwei, qimen, meihua, etc
  priority      Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Per-user master usage tracker. Chat history lives in MasterChatMessage;
/// portrait lives in UserPortrait. This row exists solely to count credits
/// spent on the master endpoint via totalCreditsUsed.
model MasterSession {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalCreditsUsed Int      @default(0)
  /// Last-seen client timezone offset (Date.getTimezoneOffset() minutes; UTC+8 → -480).
  /// Timezone fallback for server-initiated turns (check-ins / reflections).
  tzOffsetMin      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

// ─── Master memory tables (Phase 1+) ──────────────────────────────────────
// See docs/master-portrait-system-plan.md for the full design.

/// Raw chat message store. Replaces MasterSession.messages JSON blob with
/// per-message rows so compression can operate as queries instead of array
/// slicing. Each row records the original turn — synthetic system messages
/// (e.g. compressed summary stubs) get a metadata.synthetic flag in toolCallsJson.
model MasterChatMessage {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String   // groups messages between hard-clears / new-session resets
  turnIndex     Int      // monotonic per session, even = user, odd = assistant
  role          String   // 'user' | 'assistant' | 'system' | 'tool'
  content       String?  @db.Text
  toolCallsJson String?  @db.Text // assistant tool_calls or tool result payload
  toolCallId    String?  // for role='tool' messages, links to assistant call
  tokenCount    Int?     // estimated, for compression decisions
  archivedAt    DateTime? // soft-archive flag for "Start new session" reset
  createdAt     DateTime @default(now())

  @@index([userId, sessionId, turnIndex])
  @@index([userId, sessionId, archivedAt])
  @@index([userId, createdAt])
}

/// Long-term user portrait — one row per user. Captures stable preferences
/// and topics extracted from conversation history. Updated incrementally:
/// the extractor only sees new messages since lastTurnIndexCovered.
model UserPortrait {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version              Int      @default(1)
  topics               String   @db.Text // JSON array
  preferences          String   @db.Text // JSON object: {tone, depth, language}
  lifeContext          String?  @db.Text
  toneNotes            String?  @db.Text
  generatedPrompt      String?  @db.Text // rendered personalized prompt block (cached)
  lastExtractedAt      DateTime @default(now())
  lastTurnIndexCovered Int      @default(0)
  lastManualEditAt     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// Append-only audit trail for portrait updates. Lets users see their own
/// portrait history (manual edits + auto-extraction events) and admins debug
/// extraction quality. Trigger: 'auto' | 'manual' | 'admin' | 'restore'.
model UserPortraitHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     Int
  topics      String   @db.Text
  preferences String   @db.Text
  lifeContext String?  @db.Text
  toneNotes   String?  @db.Text
  trigger     String
  createdAt   DateTime @default(now())

  @@index([userId, version])
  @@index([userId, createdAt])
}

/// Admin access log. Every admin action against another user's master data
/// is logged here. Used by the admin debug page (Phase 7) and surfaced in
/// the page itself for peer-policing.
model AdminAccessLog {
  id           String   @id @default(cuid())
  adminUserId  String
  adminUser    User     @relation("AdminAccessLog_admin", fields: [adminUserId], references: [id])
  targetUserId String
  targetUser   User     @relation("AdminAccessLog_target", fields: [targetUserId], references: [id], onDelete: Cascade)
  action       String   // 'view_master_debug' | 'force_extract_portrait' | 'reset_portrait' | 'clear_chat' | 'toggle_enabled'
  reason       String?  @db.Text
  metadata     String?  @db.Text // JSON: action-specific context
  createdAt    DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([targetUserId, createdAt])
}
