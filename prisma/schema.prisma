generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  password     String
  name         String?
  language     String      @default("zh")
  birthDate    String?
  birthTime    String?
  birthPlace   String?
  gender       String?
  timeMode     String?     // "fuzzy" | "precise"
  exactTime    String?     // "HH:MM" for precise mode
  calendarType String?     // "solar" | "lunar"
  birthEnvironment String? // geographic birth environment (rural, urban, mountainous, etc.)
  birthLat         Float?
  birthLng         Float?
  isAdmin      Boolean     @default(false)
  isPaid       Boolean     @default(false)
  role         String      @default("user") // user | admin
  credits            Int       @default(3)  // unified credit points
  divinationCredits  Int       @default(3)  // deprecated — kept for migration
  chatCredits        Int       @default(3)  // deprecated — kept for migration
  usageDivination    Int       @default(0)  // audit: total divination count
  usageChat          Int       @default(0)  // audit: total chat Q&A rounds
  usageMaster        Int       @default(0)  // audit: total master conversation turns
  lastDailyBonus     DateTime?
  emailVerified     Boolean   @default(false)
  verificationToken String?   @unique
  tokenExpiry       DateTime?
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  deleteToken       String?   @unique
  deleteTokenExpiry DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  subscriptionStatus   String?   // active, canceled, past_due
  chatSummary  String?     @db.Text
  hourlyQuota  Int         @default(10)
  bonusModel1  Int         @default(0)
  bonusModel2  Int         @default(0)
  bonusChat    Int         @default(0)
  consentAt    DateTime?
  consentVersion String?   // version of privacy/terms the user agreed to
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  readings      Reading[]
  rateLimits    RateLimit[]
  shareLinks    ShareLink[]
  familyMembers FamilyMember[]
  masterSession MasterSession?
  deviceTokens  DeviceToken[]
  notificationReads NotificationRead[]
}

model Reading {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  modelTier      String        @default("model1")
  question       String?
  inputData      Json
  result         String        @db.Text
  language       String        @default("zh")
  targetType     String        @default("self")
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  status          String        @default("completed") // pending | completed | failed
  calculationData String?     @db.Text  // Raw programmatic calculation output (JSON) — BaZi/Ziwei/Qimen/Meihua
  llmPrompt       String?     @db.Text  // Full LLM prompt (system + user message)
  llmRawOutput    String?     @db.Text  // Raw LLM response before merge
  chatMessages    String?     @db.Text  // JSON array of {role, content, timestamp} chat messages
  rating         Int?          // 1-5 star rating (denormalized from ReadingFeedback)
  shareToken     String?       @unique
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  feedbacks       ReadingFeedback[]

  @@index([userId])
  @@index([createdAt])
  @@index([userId, deletedAt])
  @@index([type])
}

model ReadingFeedback {
  id        String   @id @default(cuid())
  readingId String
  reading   Reading  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int?     // 1-5
  feedback  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([readingId, userId])
  @@index([readingId])
  @@index([userId])
}

model FamilyMember {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relation         String
  name             String?
  birthDate        String?
  birthTime        String?
  birthPlace       String?
  gender           String?
  calendarType     String?   // "solar" or "lunar"
  timeMode         String?   // "fuzzy" or "exact"
  exactTime        String?   // "HH:MM" for precise mode
  birthLat         Float?
  birthLng         Float?
  birthEnvironment String? // geographic birth environment (rural, urban, mountainous, etc.)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  readings         Reading[]

  @@index([userId])
}

model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStart DateTime
  count       Int      @default(0)
  modelTier   String   @default("model1")
  updatedAt   DateTime @updatedAt

  @@unique([userId, windowStart, modelTier])
  @@index([userId, windowStart])
}

model ShareLink {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String    @unique
  used      Boolean   @default(false)
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LlmLog {
  id            String   @id @default(cuid())
  userId        String?
  endpoint      String   // "divination" | "chat" | "chat-summary"
  model         String   // actual model name used
  modelTier     String?  // "model1" | "model2"
  promptTokens  Int      @default(0)
  completionTokens Int   @default(0)
  totalTokens   Int      @default(0)
  latencyMs     Int      @default(0)
  status        String   @default("success") // "success" | "error"
  errorMessage  String?
  inputPreview  String?  @db.Text // user message (full)
  outputPreview String?  @db.Text // LLM response (full)
  systemPrompt  String?  @db.Text // system prompt (full)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([endpoint])
}

model AdminSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SiteFeedback {
  id        String   @id @default(cuid())
  userId    String
  rating    Int?     // 1-5
  feedback  String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Compensation {
  id          String   @id @default(cuid())
  userId      String?
  email       String   // target email (may not have account yet)
  reason      String   @db.Text
  sourceType  String   @default("manual") // "error_log" | "llm_error" | "manual"
  sourceIds   String?  @db.Text // comma-separated error/log IDs
  bonusModel1 Int      @default(0)
  bonusModel2 Int      @default(0)
  bonusChat   Int      @default(0)
  token       String   @unique
  status      String   @default("pending") // "pending" | "sent" | "claimed" | "expired"
  createdAt   DateTime @default(now())
  sentAt      DateTime?
  claimedAt   DateTime?
  expiresAt   DateTime?

  @@index([email])
  @@index([status])
  @@index([token])
}

model AuthLog {
  id        String   @id @default(cuid())
  action    String   // "login" | "logout" | "register"
  status    String   // "success" | "failure"
  email     String
  userId    String?
  reason    String?  // failure reason: "invalid_password", "user_not_found", "email_not_verified", "email_exists", etc.
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email])
  @@index([action])
  @@index([status])
}

model FrontendError {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   // API endpoint that failed
  status    Int?     // HTTP status code
  error     String   @db.Text // error message
  context   String?  @db.Text // extra context (page, action, etc.)
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  titleEn   String
  content   String   @db.Text
  contentEn String   @db.Text
  type      String   @default("info")
  target    String   @default("all")
  active    Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reads     NotificationRead[]

  @@index([active])
  @@index([createdAt])
}

model NotificationRead {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([userId, notificationId])
  @@index([userId])
  @@index([notificationId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @db.Text
  platform  String   // "ios" | "android"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@index([token])
}

model WelcomeRule {
  id            String   @id @default(cuid())
  name          String
  condition     Json     // { stage: "new"|"beginner"|"intermediate"|"advanced"|"expert", isWeekend?: boolean }
  messages      Json     // { zh: ["msg1","msg2",...], en: ["msg1","msg2",...] }
  recommendType String?  // bazi, liuyao, ziwei, qimen, meihua, etc
  priority      Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MasterSession {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         String   @db.Text // JSON array of {role, content, timestamp, toolCalls?}
  portrait         String?  @db.Text // JSON: user portrait
  totalCreditsUsed Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}
